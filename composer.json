{
    "name": "unwahas/broadcast",
    "description": "RabbitMQ Broadcast & Multi-Queue Consumer Package for Laravel",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "rabbitmq",
        "broadcast",
        "queue",
        "consumer",
        "unwahas"
    ],
    "authors": [
        {
            "name": "UNWAHAS Dev Team"
        }
    ],
    "require": {
        "php": ">=8.1",
        "php-amqplib/php-amqplib": "^3.5 || >=3.5",
        "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0 || >=9.0",
        "illuminate/console": "^9.0 || ^10.0 || ^11.0 || ^12.0 || >=9.0"
    },
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Unwahas\\Broadcast\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Unwahas\\Broadcast\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Unwahas\\Broadcast\\BroadcastServiceProvider"
            ],
            "aliases": {
                "RabbitMqBroadcast": "Unwahas\\Broadcast\\Facades\\RabbitMqBroadcast"
            }
        }
    }
}
